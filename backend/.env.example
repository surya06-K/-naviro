# Copy this file to .env and fill in your actual keys
# Get your Groq API key (free) from: https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Optional: enables more accurate place geocoding and turn-by-turn directions.
# Enable the Geocoding, Places, and Directions APIs for this key in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Comma-separated list of allowed frontend origins for CORS:
# Examples:
#   ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Optional single frontend URL (added to ALLOWED_ORIGINS if set)
FRONTEND_URL=

# Set to true only when Vercel preview deployments must call this backend.
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# API protection defaults. Use Redis-backed limiting before multiple backend instances.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=50000
MAX_ACTIVE_SESSIONS=1000
LLM_TIMEOUT_SECONDS=30
