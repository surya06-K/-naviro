# Copy this file to .env and fill in your actual keys
# Get your Groq API key (free) from: https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Model to use for itinerary generation. Must support Groq's strict json_schema
# structured outputs (currently openai/gpt-oss-120b or openai/gpt-oss-20b — check
# https://console.groq.com/docs/structured-outputs for the current list). Override
# this if Groq deprecates the default, same as it did llama-3.3-70b-versatile.
GROQ_MODEL=openai/gpt-oss-120b

# Optional but strongly recommended: powers place verification (is this a real,
# locatable place?) and geocoding. Free tier, no credit card required — sign up
# at https://locationiq.com. Without this, every place falls back to slower
# public Nominatim lookups and nothing gets verified as real.
LOCATIONIQ_API_KEY=

# Optional: adds a one-line "current weather in the destination city" note to
# the planning context (free tier — sign up at https://openweathermap.org).
# Trip planning degrades gracefully without it: weather context is silently
# omitted, same as the Google Maps key above.
OPENWEATHER_API_KEY=

# Comma-separated list of allowed frontend origins for CORS:
# Examples:
#   ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Optional single frontend URL (added to ALLOWED_ORIGINS if set)
FRONTEND_URL=

# Set to true only when Vercel preview deployments must call this backend.
ALLOW_VERCEL_PREVIEW_ORIGINS=false

# API protection defaults. Use Redis-backed limiting before multiple backend instances.
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=50000
MAX_ACTIVE_SESSIONS=1000
LLM_TIMEOUT_SECONDS=30
